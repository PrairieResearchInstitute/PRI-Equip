# The supervisor writes these; they are machine-local noise
data/server.log
data/php-stderr.log
data/backup.log
data/.installed

# Local configuration and secrets. The .example file is the template.
.env

# SQLite runtime sidecars. The WAL holds real database pages - rows that
# have not yet been checkpointed into the main file - so it is data, not
# scratch. *.sqlite alone does not match them.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db-wal
*.db-shm

# Portable-mode settings for this copy (includes/local-config.php); never committed
config.local.json
config.local.json.tmp

# Reference material: specs, deployment notes, runtime readmes. Never pushed.
reference/

